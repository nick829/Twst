# Bind to the UDP port allocated to this server in FeatherPanel.
LISTEN_ADDR=0.0.0.0:25665
# Bedrock destination in host:port format. Set this in FeatherPanel Startup Variables.
REMOTE_ADDR=summitsurvival.org:63809
# Local folder containing custom Bedrock resource packs next to the executable.
RESOURCE_PACK_DIR=resource_packs
# Persistent Microsoft/Xbox OAuth token file. Keep it when restarting or replacing server; never share/upload it.
AUTH_TOKEN_FILE=.novabedrock-auth.json
# Prefix for local proxy chat commands.
COMMAND_PREFIX=.
# Preserve forwarding of unrecognized dot-prefixed messages to the destination.
FORWARD_UNKNOWN_PREFIX_COMMANDS=true
# Collect bounded packet diagnostics for LevelChunk, UpdateBlock, PlayerAuthInput, and MovePlayer packets.
SCANNER_ENABLED=true
# Maximum recent packet-metadata entries retained in memory (0 disables history; allowed range: 0-4096).
SCANNER_CACHE_LIMIT=256
